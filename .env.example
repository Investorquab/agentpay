# Server-side Stellar facilitator account (testnet secret; never expose client-side)
TREASURY_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Stellar account that receives settled USDC
RECEIVING_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Pollar publishable key — safe for the browser. Get this from your Pollar app dashboard.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=

# Backward-compatible alias accepted by AgentPay
NEXT_PUBLIC_POLLAR_API_KEY=

# Keep testnet for the hackathon demo
NEXT_PUBLIC_X402_NETWORK=stellar:testnet
